# --- CallTrackingMetrics API credentials ---
# CTM > Settings > Account Settings > API Integration (access key + secret key)
CTM_ACCESS_KEY=
CTM_SECRET_KEY=
# Numeric account id (visible in the CTM URL / API settings page)
CTM_ACCOUNT_ID=
CTM_BASE_URL=https://api.calltrackingmetrics.com

# --- App ---
# SQLite by default; any SQLAlchemy URL works, e.g. postgresql+psycopg://user:pass@host/db
DATABASE_URL=sqlite:///./ctm.db
# Long random string used to sign login sessions. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Set to true when served over HTTPS (marks the session cookie Secure)
SESSION_HTTPS_ONLY=false
# Time zone used for dashboards, date filters and "calls by hour"
TIMEZONE=America/New_York

# --- Sync ---
# How often the built-in worker pulls new/updated calls from CTM (0 disables it)
SYNC_INTERVAL_MINUTES=10
# How far back the very first sync goes
INITIAL_SYNC_DAYS=30

# --- Real-time webhook (optional) ---
# Shared secret for POST /webhooks/ctm?token=... ; leave empty to disable the endpoint
WEBHOOK_TOKEN=

# --- QA scores ---
# When true, managers can push a QA review score back to the call's "sale" record in CTM
PUSH_SCORES_TO_CTM=false
